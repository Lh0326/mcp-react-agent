# Copy to .env. Never commit real credentials.
DASHSCOPE_API_KEY=
MODEL=qwen-plus

# Required only when query_weather is called.
OPENWEATHER_API_KEY=

# Enable amap-maps in servers_config.json after setting a valid SSE URL.
AMAP_MCP_SSE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_TIMEOUT_SECONDS=120
